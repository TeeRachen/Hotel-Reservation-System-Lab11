{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "module": "CommonJS",
          "moduleResolution": "Node",
          "resolvePackageJsonExports": false
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(?:@nestjs/(?:jwt|cache-manager)|cache-manager|keyv|@cacheable)/)"
  ]
}
